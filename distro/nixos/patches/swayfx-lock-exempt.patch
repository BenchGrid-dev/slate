+
+bool seat_is_lock_exempt(struct sway_seat *seat) {
+	if (!seat->transient) {
+		return false;
+	}
+	struct seat_config *seat_config = seat_get_config(seat);
+	return seat_config && seat_config->lock_exempt == 1;
+}
