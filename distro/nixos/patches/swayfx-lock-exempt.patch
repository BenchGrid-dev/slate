diff --git a/sway/commands/seat/lock_exempt.c b/sway/commands/seat/lock_exempt.c
new file mode 100644
index 0000000..18675b0
--- /dev/null
+++ b/sway/commands/seat/lock_exempt.c
@@ -0,0 +1,26 @@
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "util.h"
+
+// seat <name> lock_exempt yes|no: while the session is locked, this seat keeps its
+// focus and its input reaches the windows behind the lock screen, never the lock
+// screen itself. It applies only to a seat a client created through ext-transient-seat
+// (an agent's virtual seat, which no person types on), configured by its exact name:
+// never to the person's seats, never through "seat *".
+struct cmd_results *seat_cmd_lock_exempt(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "lock_exempt", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct seat_config *seat_config = config->handler_context.seat_config;
+	if (!seat_config) {
+		return cmd_results_new(CMD_FAILURE, "No seat defined");
+	}
+	if (strcmp(seat_config->name, "*") == 0) {
+		return cmd_results_new(CMD_INVALID,
+			"lock_exempt applies to one transient seat by name, not to *");
+	}
+	seat_config->lock_exempt = parse_boolean(argv[0], false);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
