-		return sway_session_lock_has_surface(server.session_lock.lock, surface);
+		// An exempt seat reaches everything but the lock screen.
+		bool lock_screen = sway_session_lock_has_surface(server.session_lock.lock,
+			wlr_surface_get_root_surface(surface));
+		return seat_is_lock_exempt(seat) ? !lock_screen : lock_screen;
 	}
 	return true;
 }
