diff --git a/sway/titlebar_buttons.c b/sway/titlebar_buttons.c
new file mode 100644
index 0000000..f9df57a
--- /dev/null
+++ b/sway/titlebar_buttons.c
@@ -0,0 +1,274 @@
+#include <cairo.h>
+#include <drm_fourcc.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_output.h>
+#include "log.h"
+#include "sway/titlebar_buttons.h"
+
+// M_PI is not in strict C11
+#define TWO_PI 6.28318530717958647692
+
+struct button_cairo_buffer {
+	struct wlr_buffer base;
+	cairo_surface_t *surface;
+	cairo_t *cairo;
+};
+
+static void button_cairo_buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct button_cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	cairo_surface_destroy(buffer->surface);
+	cairo_destroy(buffer->cairo);
+	free(buffer);
+}
+
+static bool button_cairo_buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct button_cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	*data = cairo_image_surface_get_data(buffer->surface);
+	*stride = cairo_image_surface_get_stride(buffer->surface);
+	*format = DRM_FORMAT_ARGB8888;
+	return true;
+}
+
+static void button_cairo_buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	// This space is intentionally left blank
+}
+
+static const struct wlr_buffer_impl button_cairo_buffer_impl = {
+	.destroy = button_cairo_buffer_destroy,
+	.begin_data_ptr_access = button_cairo_buffer_begin_data_ptr_access,
+	.end_data_ptr_access = button_cairo_buffer_end_data_ptr_access,
+};
+
+struct buttons_buffer {
+	struct wlr_scene_buffer *buffer_node;
+	struct sway_titlebar_buttons props;
+
+	bool visible;
+	float scale;
+
+	struct wl_listener outputs_update;
+	struct wl_listener destroy;
+};
+
+int titlebar_buttons_width(struct sway_titlebar_buttons *buttons) {
+	return TITLEBAR_BUTTON_COUNT * buttons->diameter
+		+ (TITLEBAR_BUTTON_COUNT - 1) * buttons->spacing;
+}
+
+static void draw_glyph(cairo_t *cairo, int button, bool maximized,
+		double cx, double cy, double h) {
+	switch (button) {
+	case TITLEBAR_BUTTON_MINIMIZE:
+		cairo_move_to(cairo, cx - h, cy + h * 0.5);
+		cairo_line_to(cairo, cx + h, cy + h * 0.5);
+		break;
+	case TITLEBAR_BUTTON_MAXIMIZE:
+		if (maximized) {
+			// Restore: a square in front of another.
+			double off = h * 0.55;
+			cairo_move_to(cairo, cx - h + off, cy - h + off);
+			cairo_line_to(cairo, cx - h + off, cy - h);
+			cairo_line_to(cairo, cx + h, cy - h);
+			cairo_line_to(cairo, cx + h, cy + h - off);
+			cairo_line_to(cairo, cx + h - off, cy + h - off);
+			cairo_rectangle(cairo, cx - h, cy - h + off, 2 * h - off, 2 * h - off);
+		} else {
+			cairo_rectangle(cairo, cx - h, cy - h, 2 * h, 2 * h);
+		}
+		break;
+	case TITLEBAR_BUTTON_CLOSE:
+		h *= 0.92;
+		cairo_move_to(cairo, cx - h, cy - h);
+		cairo_line_to(cairo, cx + h, cy + h);
+		cairo_move_to(cairo, cx + h, cy - h);
+		cairo_line_to(cairo, cx - h, cy + h);
+		break;
+	}
+	cairo_stroke(cairo);
+}
+
+static void render_backing_buffer(struct buttons_buffer *buffer) {
+	if (!buffer->visible) {
+		return;
+	}
+
+	struct sway_titlebar_buttons *props = &buffer->props;
+	int logical_width = titlebar_buttons_width(props);
+	int logical_height = props->diameter;
+	if (logical_width <= 0 || logical_height <= 0) {
+		wlr_scene_buffer_set_buffer(buffer->buffer_node, NULL);
+		return;
+	}
+
+	float scale = buffer->scale > 0 ? buffer->scale : 1;
+	int width = ceil(logical_width * scale);
+	int height = ceil(logical_height * scale);
+
+	cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width, height);
+	if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+		sway_log(SWAY_ERROR, "cairo_image_surface_create failed");
+		cairo_surface_destroy(surface);
+		return;
+	}
+	struct button_cairo_buffer *cairo_buffer = calloc(1, sizeof(*cairo_buffer));
+	if (!cairo_buffer) {
+		cairo_surface_destroy(surface);
+		return;
+	}
+	cairo_t *cairo = cairo_create(surface);
+
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	cairo_scale(cairo, scale, scale);
+
+	float *c = props->color;
+	double r = props->diameter / 2.0;
+	// Glyphs about a third of the button, strokes of one and a half points (one
+	// point on a low-density screen, where a half point only blurs).
+	double h = fmax(3.0, round(props->diameter * 0.38) / 2.0);
+	cairo_set_line_width(cairo, scale >= 2 ? 1.5 : 1.0);
+	cairo_set_line_cap(cairo, CAIRO_LINE_CAP_ROUND);
+	cairo_set_line_join(cairo, CAIRO_LINE_JOIN_ROUND);
+
+	for (int i = 0; i < TITLEBAR_BUTTON_COUNT; i++) {
+		double cx = r + i * (props->diameter + props->spacing);
+		double cy = r;
+		double alpha = i == props->pressed ? 0.28 : i == props->hovered ? 0.18 : 0.10;
+		cairo_set_source_rgba(cairo, c[0], c[1], c[2], c[3] * alpha);
+		cairo_arc(cairo, cx, cy, r, 0, TWO_PI);
+		cairo_fill(cairo);
+
+		cairo_set_source_rgba(cairo, c[0], c[1], c[2], c[3]);
+		draw_glyph(cairo, i, props->maximized, cx, cy, h);
+	}
+	cairo_surface_flush(surface);
+
+	wlr_buffer_init(&cairo_buffer->base, &button_cairo_buffer_impl, width, height);
+	cairo_buffer->surface = surface;
+	cairo_buffer->cairo = cairo;
+
+	wlr_scene_buffer_set_buffer(buffer->buffer_node, &cairo_buffer->base);
+	wlr_buffer_drop(&cairo_buffer->base);
+	wlr_scene_buffer_set_dest_size(buffer->buffer_node, logical_width, logical_height);
+}
+
+static void handle_outputs_update(struct wl_listener *listener, void *data) {
+	struct buttons_buffer *buffer = wl_container_of(listener, buffer, outputs_update);
+	struct wlr_scene_outputs_update_event *event = data;
+
+	float scale = 0;
+	for (size_t i = 0; i < event->size; i++) {
+		struct wlr_scene_output *output = event->active[i];
+		if (scale < output->output->scale) {
+			scale = output->output->scale;
+		}
+	}
+
+	bool was_visible = buffer->visible;
+	buffer->visible = event->size > 0;
+	if (scale != buffer->scale || (buffer->visible && !was_visible)) {
+		buffer->scale = scale;
+		render_backing_buffer(buffer);
+	}
+}
+
+static void handle_destroy(struct wl_listener *listener, void *data) {
+	struct buttons_buffer *buffer = wl_container_of(listener, buffer, destroy);
+	wl_list_remove(&buffer->outputs_update.link);
+	wl_list_remove(&buffer->destroy.link);
+	free(buffer);
+}
+
+struct sway_titlebar_buttons *titlebar_buttons_create(struct wlr_scene_tree *parent) {
+	struct buttons_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		return NULL;
+	}
+	struct wlr_scene_buffer *node = wlr_scene_buffer_create(parent, NULL);
+	if (!node) {
+		free(buffer);
+		return NULL;
+	}
+	buffer->buffer_node = node;
+	buffer->props.node = &node->node;
+	buffer->props.diameter = 0;
+	buffer->props.spacing = 0;
+	buffer->props.hovered = TITLEBAR_BUTTON_NONE;
+	buffer->props.pressed = TITLEBAR_BUTTON_NONE;
+
+	buffer->destroy.notify = handle_destroy;
+	wl_signal_add(&node->node.events.destroy, &buffer->destroy);
+	buffer->outputs_update.notify = handle_outputs_update;
+	wl_signal_add(&node->events.outputs_update, &buffer->outputs_update);
+
+	return &buffer->props;
+}
+
+void titlebar_buttons_set_size(struct sway_titlebar_buttons *buttons,
+		int diameter, int spacing) {
+	if (buttons->diameter == diameter && buttons->spacing == spacing) {
+		return;
+	}
+	buttons->diameter = diameter;
+	buttons->spacing = spacing;
+	struct buttons_buffer *buffer = wl_container_of(buttons, buffer, props);
+	// The size first: the scene tells a node which outputs it is on (and so that it
+	// is visible, and at what scale to draw) only once it has one.
+	wlr_scene_buffer_set_dest_size(buffer->buffer_node,
+		titlebar_buttons_width(buttons), diameter);
+	render_backing_buffer(buffer);
+}
+
+void titlebar_buttons_set_color(struct sway_titlebar_buttons *buttons, float color[4]) {
+	if (memcmp(buttons->color, color, sizeof(buttons->color)) == 0) {
+		return;
+	}
+	memcpy(buttons->color, color, sizeof(buttons->color));
+	struct buttons_buffer *buffer = wl_container_of(buttons, buffer, props);
+	render_backing_buffer(buffer);
+}
+
+void titlebar_buttons_set_state(struct sway_titlebar_buttons *buttons,
+		int hovered, int pressed) {
+	if (buttons->hovered == hovered && buttons->pressed == pressed) {
+		return;
+	}
+	buttons->hovered = hovered;
+	buttons->pressed = pressed;
+	struct buttons_buffer *buffer = wl_container_of(buttons, buffer, props);
+	render_backing_buffer(buffer);
+}
+
+void titlebar_buttons_set_maximized(struct sway_titlebar_buttons *buttons, bool maximized) {
+	if (buttons->maximized == maximized) {
+		return;
+	}
+	buttons->maximized = maximized;
+	struct buttons_buffer *buffer = wl_container_of(buttons, buffer, props);
+	render_backing_buffer(buffer);
+}
+
+enum sway_titlebar_button titlebar_buttons_at(struct sway_titlebar_buttons *buttons,
+		double lx, double ly) {
+	int x, y;
+	if (!wlr_scene_node_coords(buttons->node, &x, &y) || buttons->diameter <= 0) {
+		return TITLEBAR_BUTTON_NONE;
+	}
+	// Each button answers in its own cell: its circle and half the gaps around it,
+	// a little taller than the circle, so a click need not be exact.
+	double rx = lx - x, ry = ly - y;
+	double pad = buttons->spacing / 2.0;
+	if (ry < -pad || ry > buttons->diameter + pad) {
+		return TITLEBAR_BUTTON_NONE;
+	}
+	double cell = buttons->diameter + buttons->spacing;
+	int i = floor((rx + pad) / cell);
+	if (rx < -pad || i < 0 || i >= TITLEBAR_BUTTON_COUNT) {
+		return TITLEBAR_BUTTON_NONE;
+	}
+	return i;
+}
