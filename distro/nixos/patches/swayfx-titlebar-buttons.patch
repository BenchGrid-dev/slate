+#ifndef _SWAY_TITLEBAR_BUTTONS_H
+#define _SWAY_TITLEBAR_BUTTONS_H
+#include <scenefx/types/wlr_scene.h>
+
+/**
+ * Minimize, maximize and close buttons at the right of a title bar: round,
+ * monochrome buttons drawn in the title's colour, like libadwaita's.
+ */
+enum sway_titlebar_button {
+	TITLEBAR_BUTTON_NONE = -1,
+	TITLEBAR_BUTTON_MINIMIZE = 0,
+	TITLEBAR_BUTTON_MAXIMIZE = 1,
+	TITLEBAR_BUTTON_CLOSE = 2,
+};
+
+#define TITLEBAR_BUTTON_COUNT 3
+
+struct sway_titlebar_buttons {
+	struct wlr_scene_node *node;
+	int diameter;
+	int spacing;
+	// TITLEBAR_BUTTON_* or TITLEBAR_BUTTON_NONE
+	int hovered;
+	int pressed;
+	bool maximized;
+	float color[4];
+};
+
+struct sway_titlebar_buttons *titlebar_buttons_create(struct wlr_scene_tree *parent);
+
+/** The width of the three buttons and the gaps between them. */
+int titlebar_buttons_width(struct sway_titlebar_buttons *buttons);
+
+void titlebar_buttons_set_size(struct sway_titlebar_buttons *buttons,
+		int diameter, int spacing);
+
+void titlebar_buttons_set_color(struct sway_titlebar_buttons *buttons, float color[4]);
+
+void titlebar_buttons_set_state(struct sway_titlebar_buttons *buttons,
+		int hovered, int pressed);
+
+void titlebar_buttons_set_maximized(struct sway_titlebar_buttons *buttons, bool maximized);
+
+/** The button under layout point (lx, ly), or TITLEBAR_BUTTON_NONE. */
+enum sway_titlebar_button titlebar_buttons_at(struct sway_titlebar_buttons *buttons,
+		double lx, double ly);
+
+#endif
