+static void view_send_maximized(struct sway_view *view, bool maximized) {
+	if (view->type == SWAY_VIEW_XDG_SHELL && view->wlr_xdg_toplevel &&
+			view->wlr_xdg_toplevel->base->initialized) {
+		wlr_xdg_toplevel_set_maximized(view->wlr_xdg_toplevel, maximized);
+	}
+#if WLR_HAS_XWAYLAND
+	if (view->type == SWAY_VIEW_XWAYLAND && view->wlr_xwayland_surface) {
+		wlr_xwayland_surface_set_maximized(view->wlr_xwayland_surface,
+			maximized, maximized);
+	}
+#endif
+	if (view->foreign_toplevel) {
+		wlr_foreign_toplevel_handle_v1_set_maximized(view->foreign_toplevel, maximized);
+	}
+}
+
+static void container_floating_set_box(struct sway_container *con,
+		const struct wlr_box *box) {
+	con->pending.x = box->x;
+	con->pending.y = box->y;
+	con->pending.width = box->width;
+	con->pending.height = box->height;
+	// view_autoconfigure derives the content geometry from the container's
+	arrange_container(con);
+}
+
+void container_set_maximized(struct sway_container *con, bool enable) {
+	if (!con->view || !container_is_floating(con) || !con->pending.workspace ||
+			con->pending.fullscreen_mode != FULLSCREEN_NONE) {
+		return;
+	}
+	if (enable != con->maximized) {
+		struct sway_workspace *ws = con->pending.workspace;
+		if (enable) {
+			con->maximize_saved = (struct wlr_box){
+				.x = con->pending.x,
+				.y = con->pending.y,
+				.width = con->pending.width,
+				.height = con->pending.height,
+			};
+			struct wlr_box box = { .x = ws->x, .y = ws->y,
+				.width = ws->width, .height = ws->height };
+			container_floating_set_box(con, &box);
+		} else if (!wlr_box_empty(&con->maximize_saved)) {
+			container_floating_set_box(con, &con->maximize_saved);
+		}
+		con->maximized = enable;
+		container_raise_floating(con);
+	}
+	view_send_maximized(con->view, con->maximized);
+	node_set_dirty(&con->node);
+}
+
+void container_clear_maximized(struct sway_container *con) {
+	if (!con->maximized) {
+		return;
+	}
+	con->maximized = false;
+	if (con->view) {
+		view_send_maximized(con->view, false);
+	}
+	node_set_dirty(&con->node);
+}
+
+void container_minimize(struct sway_container *con) {
+	if (!con->pending.workspace) {
+		while (con->pending.parent) {
+			con = con->pending.parent;
+		}
+	}
+	if (!con->scratchpad) {
+		root_scratchpad_add_container(con, NULL);
+	} else if (con->pending.workspace) {
+		root_scratchpad_hide(con);
+	}
+}
