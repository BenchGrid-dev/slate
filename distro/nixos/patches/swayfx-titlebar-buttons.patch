+	size_t button_press_con;
+	int button_press;
 };
 
+// The last press on a floating view's title bar, for double clicks. It outlives
+// the seatop: the press itself starts a move.
+static struct {
+	struct sway_seat *seat;
+	size_t con;
+	uint32_t msec;
+} titlebar_click;
+
+#define TITLEBAR_DOUBLE_CLICK_MSEC 400
+
+/*-----------------------------------------\
+ * Title bar buttons                       /
+ *---------------------------------------*/
+
+static bool container_has_id(struct sway_container *con, void *data) {
+	return con->node.id == *(size_t *)data;
+}
+
+static struct sway_container *container_by_id(size_t id) {
+	return id ? root_find_container(container_has_id, &id) : NULL;
+}
+
+static int titlebar_button_at(struct sway_container *cont,
+		struct wlr_surface *surface, struct sway_cursor *cursor) {
+	if (!cont || surface || !container_has_titlebar_buttons(cont)) {
+		return TITLEBAR_BUTTON_NONE;
+	}
+	return titlebar_buttons_at(cont->title_bar.buttons,
+		cursor->cursor->x, cursor->cursor->y);
+}
+
+static void titlebar_buttons_show(struct seatop_default_event *e,
+		size_t con_id, int hover) {
+	size_t old = e->button_hover_con;
+	e->button_hover_con = hover == TITLEBAR_BUTTON_NONE ? 0 : con_id;
+	e->button_hover = hover;
+	struct sway_container *con;
+	if (old && old != e->button_hover_con && (con = container_by_id(old)) &&
+			con->title_bar.buttons) {
+		titlebar_buttons_set_state(con->title_bar.buttons,
+			TITLEBAR_BUTTON_NONE, TITLEBAR_BUTTON_NONE);
+	}
+	if (e->button_hover_con && (con = container_by_id(e->button_hover_con)) &&
+			con->title_bar.buttons) {
+		// Pressed only while the cursor is still on the button it went down on.
+		bool held = e->button_press_con == e->button_hover_con &&
+			e->button_press == hover;
+		titlebar_buttons_set_state(con->title_bar.buttons, hover,
+			held ? hover : TITLEBAR_BUTTON_NONE);
+	}
+}
+
+static void titlebar_button_activate(struct sway_seat *seat,
+		struct sway_container *con, int button) {
+	switch (button) {
+	case TITLEBAR_BUTTON_CLOSE:
+		view_close(con->view);
+		break;
+	case TITLEBAR_BUTTON_MINIMIZE:
+		container_minimize(con);
+		break;
+	case TITLEBAR_BUTTON_MAXIMIZE:
+		container_set_maximized(con, !con->maximized);
+		seat_set_focus_container(seat, con);
+		break;
+	}
+	transaction_commit_dirty();
+}
+
+/**
+ * Press and release of the left button on a title bar button. Returns whether
+ * the event was the buttons'.
+ */
+static bool handle_titlebar_button(struct sway_seat *seat,
+		struct seatop_default_event *e, struct sway_container *cont,
+		struct wlr_surface *surface, enum wl_pointer_button_state state) {
+	int hit = titlebar_button_at(cont, surface, seat->cursor);
+	if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
+		if (hit == TITLEBAR_BUTTON_NONE) {
+			return false;
+		}
+		e->button_press_con = cont->node.id;
+		e->button_press = hit;
+		titlebar_buttons_show(e, cont->node.id, hit);
+		return true;
+	}
+	if (e->button_press == TITLEBAR_BUTTON_NONE) {
+		return false;
+	}
+	size_t pressed_con = e->button_press_con;
+	int pressed = e->button_press;
+	e->button_press_con = 0;
+	e->button_press = TITLEBAR_BUTTON_NONE;
+	titlebar_buttons_show(e, cont ? cont->node.id : 0, hit);
+	if (cont && cont->node.id == pressed_con && hit == pressed) {
+		titlebar_button_activate(seat, cont, pressed);
+		seatop_rebase(seat, get_current_time_in_msec());
+	}
+	return true;
+}
+
+static void update_titlebar_hover(struct sway_seat *seat,
+		struct seatop_default_event *e, struct sway_node *node,
+		struct wlr_surface *surface) {
+	struct sway_container *cont = node && node->type == N_CONTAINER ?
+		node->sway_container : NULL;
+	int hit = titlebar_button_at(cont, surface, seat->cursor);
+	titlebar_buttons_show(e, cont ? cont->node.id : 0, hit);
+}
+
