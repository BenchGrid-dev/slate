{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "network", "wireplumber", "custom/slate"],
    "custom/launcher": {
        "format": "◆",
        "tooltip-format": "Applications (Super+Space)",
        "on-click": "fuzzel"
    },
    "sway/workspaces": { "disable-scroll": true, "format": "{name}" },
    "sway/window": { "max-length": 48, "tooltip": false },
    "clock": { "format": "{:%a %d %b   %H:%M}", "tooltip-format": "<tt>{calendar}</tt>" },
    "tray": { "spacing": 10 },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": ["", "", ""],
        "tooltip-format": "{volume}% · {node_name}",
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "offline",
        "on-click": "slate-settings"
    },
    "custom/slate": {
        "exec": "slate agent-status",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "slate-shell",
        "on-click-middle": "slate-desktop show",
        "on-click-right": "slate-settings"
    }
}
