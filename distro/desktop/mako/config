font=Inter 11
background-color=#161820f5
text-color=#d7dae2
border-color=#ffffff1a
border-radius=12
border-size=1
default-timeout=6000
anchor=top-right
margin=10
padding=12,14
width=360
max-icon-size=32
progress-color=over #7c9cf5

[urgency=critical]
border-color=#e5a35a

# Clicking a Slate notification brings the slash window (approval, task result) back.
[app-name=Slate]
on-button-left=exec swaymsg '[title="^slash"] focus'
on-button-right=dismiss
