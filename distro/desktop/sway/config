# SlateOS desktop profile for sway (a conventional stacking desktop on a wlroots compositor).
# Mod = Super.  Mod+Return terminal · Mod+Space launcher · Mod+s Slate panel · Mod+w browser · Mod+e files
# Mod+q close · Mod+1..5 workspaces · Mod+Shift+1..5 move window · Mod+f fullscreen · Mod+Shift+e exit
# Mod+l lock · Mod+Escape session menu (lock, log out, restart, shut down)
set $mod Mod4
set $term foot
set $menu fuzzel
set $browser firefox
set $files thunar

font pango:Inter SemiBold 10
output HEADLESS-1 resolution 1280x800
output * bg /etc/slate/wallpaper-dark.jpg fill

# The agent's own screen: the headless backend's output, which nobody sees. The desktop
# daemon positions it far from the real screens (and keeps the real ones at (0,0)), so
# the cursor cannot wander onto it. Agent windows live on workspace "agent" there;
# Super+b brings them over ("show me") and back.
workspace agent output HEADLESS-1
output HEADLESS-1 resolution 1920x1080 bg #0c0d12 solid_color
# The "AI" workspace, left of 1 on the person's screen: a live, read-only view of the
# agent's screen (wl-mirror), so you can watch it work without moving anything.
# assign (not for_window move): the window lands there without taking the focus with it,
# so logging in still leaves you on workspace 1.
assign [app_id="at.yrlf.wl_mirror"] workspace "0:AI"

# Conventional stacking desktop: every app window floats with a title bar.
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
# The AI view is the one tiled window: it fills the workspace between the panel and the dock.
for_window [app_id="at.yrlf.wl_mirror"] floating disable, border none
# Opening sizes fit the free area (the screen less the menu bar and the dock: ppt is a
# share of it), then the window is centred there, so none starts under the dock.
for_window [app_id="foot"] resize set 900 px 560 px, move position center
for_window [app_id="firefox"] resize set 86 ppt 92 ppt, move position center
# Title bars in the colour of the window's own header (adw-gtk3), the title centred;
# focus shows in the title's colour and the shadow, as on macOS, not in a coloured bar.
default_border normal 1
default_floating_border normal 1
titlebar_padding 14 7
titlebar_border_thickness 0
title_align center
# border · background · text · indicator · child_border (slate-theme rewrites these)
client.focused          #303030 #303030 #f2f2f7 #303030 #ffffff1f
client.focused_inactive #2a2a2a #2a2a2a #8e8e93 #2a2a2a #ffffff12
client.unfocused        #2a2a2a #2a2a2a #8e8e93 #2a2a2a #ffffff12
client.urgent           #e5a35a #e5a35a #13151b #e5a35a #e5a35a
seat * xcursor_theme Bibata-Modern-Classic 24
focus_follows_mouse no
# No cursor warping on focus changes. A new window takes the focus of every seat on
# its workspace, the agent's seat included, and warping would carry the agent's idle
# cursor from its own screen to the middle of that window on the user's screen.
mouse_warping none
floating_modifier $mod normal

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+w exec $browser
bindsym $mod+e exec $files
bindsym $mod+t exec mousepad
bindsym $mod+comma exec slate-settings
bindsym $mod+s exec slate-shell
bindsym $mod+b exec slate-desktop show
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
# After the numbered ones: sway names a new output's first workspace after the first
# "workspace" binding in the config, and you should log in on 1, not on the AI view.
bindsym $mod+grave workspace "0:AI"
bindsym $mod+0 workspace "0:AI"
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym Print exec grim -g "$(slurp)" - | wl-copy
# Volume and brightness keys show a small pop-up (swayosd) as they change the level.
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower
# Lock the screen; the session menu (lock, log out, restart, shut down).
bindsym $mod+l exec slate-lock
bindsym $mod+Escape exec slate-session-menu

# While Slate borrows your mouse and keyboard, sway sits in this mode: Esc takes them back.
mode "controlling" {
    bindsym Escape exec slate-desktop takeover-cancel; mode "default"
}

# Per-user overrides written by the settings app, slate-theme and agents (display,
# colours, background, keys…). Last, so they win over the defaults above; kept outside
# /etc so the system profile stays pristine and a bad setting is one file.
# System pieces first (window effects, when the session runs SwayFX), then the person's.
include /etc/slate/sway.d/*.conf
include ~/.config/slate/sway.d/*.conf

# slateos-session-start runs first: it makes sure the background screen exists, puts
# the focus on a real screen, hands the display to systemd and starts the supervised
# services: the agent seat (it must exist before any app starts, apps ignore seats added
# later), the panel (waybar), the dock (slate-dock) and the application list (slate-apps).
# The AI workspace's view of the agent's screen is one of those services (slate-mirror).
# It also opens the first terminal: sway puts a window on the workspace that was focused
# when its command was exec'd, and at this point that is the background screen.
exec slateos-session-start
exec mako
# Volume and brightness pop-up, above the dock.
exec swayosd-server --style /etc/slate/swayosd.css --top-margin 0.74
exec sleep 3 && slate-shell --hidden
