# SlateOS desktop profile for sway (a conventional stacking desktop on a wlroots compositor).
# Mod = Super.  Mod+Return terminal · Mod+Space launcher · Mod+s Slate panel · Mod+w browser · Mod+e files
# Mod+q close · Mod+1..5 workspaces · Mod+Shift+1..5 move window · Mod+f fullscreen · Mod+Shift+e exit
set $mod Mod4
set $term foot
set $menu fuzzel
set $browser firefox
set $files thunar

font pango:Inter Medium 10
output HEADLESS-1 resolution 1280x800
output * bg /etc/slate/wallpaper.png fill

# The agent's own screen: a headless output nobody sees, far from the real ones so the
# cursor cannot wander onto it. Agent windows live on workspace "agent" there; Super+b
# brings them over ("show me") and back.
workspace agent output HEADLESS-1
output HEADLESS-1 resolution 1920x1080 position 20000 0 bg #0c0d12 solid_color

# Per-user overrides written by the settings app and by agents (display, keys…).
# Kept outside /etc so the system profile stays pristine and a bad setting is one file.
include ~/.config/slate/sway.d/*.conf

# Conventional stacking desktop: every app window floats with a title bar.
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
for_window [app_id="foot"] resize set 1000 640
for_window [app_id="firefox"] resize set 1180 740
default_border normal 1
default_floating_border normal 1
titlebar_padding 12 6
titlebar_border_thickness 0
# border · background · text · indicator · child_border
client.focused          #2a2e3a #2a2e3a #e8eaf0 #7c9cf5 #3a3f4e
client.focused_inactive #1c1f27 #1c1f27 #9ba1b0 #1c1f27 #262a36
client.unfocused        #1c1f27 #1c1f27 #6b7080 #1c1f27 #262a36
client.urgent           #e5a35a #e5a35a #13151b #e5a35a #e5a35a
seat * xcursor_theme Adwaita 24
focus_follows_mouse no
floating_modifier $mod normal

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+w exec $browser
bindsym $mod+e exec $files
bindsym $mod+t exec mousepad
bindsym $mod+comma exec slate-settings
bindsym $mod+s exec slate-shell
bindsym $mod+b exec slate-desktop show
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# While Slate borrows your mouse and keyboard, sway sits in this mode: Esc takes them back.
mode "controlling" {
    bindsym Escape exec slate-desktop takeover-cancel; mode "default"
}

bar {
    swaybar_command waybar
}

# The agent seat must exist before any app starts (apps ignore seats added later):
# hand the display to systemd and start the supervised daemon first.
# The background screen must exist before the daemon binds its pointers.
exec swaymsg create_output; sleep 0.5; systemctl --user import-environment PATH WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user restart slate-desktop.service
exec mako
exec sleep 2 && slate-shell --hidden
exec sleep 1 && foot
